hal_attribute_service(hal_huawei_wifi_tofu, hal_huawei_wifi_tofu_service)
hal_client_domain(system_server, hal_huawei_wifi_tofu)
binder_call(hal_huawei_wifi_tofu_client, hal_huawei_wifi_tofu_server)

# The stable Binder interface transfers an already connected stream endpoint. Core never
# opens a vendor socket path or establishes a connection to the vendor control socket.
allow hal_huawei_wifi_tofu_client hal_huawei_wifi_tofu_server:unix_stream_socket { read write getattr getopt shutdown };
