// fstab
prebuilt_etc {
    name: "fstab.mediapadm5lte",
    src: "fstab.mediapadm5lte",
    vendor: true,
}

prebuilt_etc {
    name: "fstab.modem",
    src: "fstab.modem",
    vendor: true,
}

prebuilt_etc {
    name: "init.mediapadm5lte.rc",
    src: "etc/init.mediapadm5lte.rc",
    sub_dir: "init/hw",
    vendor: true,
}

// hisi_log_file is core data: run its setup in init, not vendor_init.
prebuilt_etc {
    name: "init.mediapadm5lte.hisi_logs.rc",
    src: "etc/init.mediapadm5lte.hisi_logs.rc",
    sub_dir: "init",
}
